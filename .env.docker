# ============================================================
# ShopEase — Docker Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ---- Database ----
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce

# ---- Security ----
JWT_SECRET=change-this-to-a-strong-random-string-in-production

# ---- Service URLs (used by backend for CORS) ----
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CUSTOMER_SUPPORT_URL=http://localhost:3002

# ---- Vite Build-Time API URLs ----
# These are baked into the React apps at build time
VITE_ADMIN_API_URL=http://localhost:5000/api
VITE_CUSTOMER_API_URL=http://localhost:5000/api

# ---- Email (Gmail SMTP via Nodemailer) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_FROM=

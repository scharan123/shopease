PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce
JWT_SECRET=change-me

# ---------------------------------------------------------------------------
# Email / SMTP configuration (used by utils/email.js via Nodemailer)
# ---------------------------------------------------------------------------
# PRIMARY: Gmail SMTP. Gmail account must have 2-Step Verification enabled.
GMAIL_USER=your-email@gmail.com
# REAL 16-character Google App Password from
# https://myaccount.google.com/apppasswords  (NOT your normal Gmail password)
GMAIL_APP_PASSWORD=
# Sender shown to recipients ("From"). Must match the authenticated account.
SMTP_FROM=your-email@gmail.com

# Optional override: a complete SMTP_* block is used ONLY when GMAIL_USER /
# GMAIL_APP_PASSWORD are absent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=

# OTP behaviour
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30